# micro-notify
#
# Copy to .env and fill in. Never commit .env.
#
# This service declares exactly the variables it uses and is given no others. The estate it
# replaces hands every container all 64 variables through one env_file, which is how the game
# container ends up holding the custody master secret.

# ---- service ----------------------------------------------------------------
# 4012, matching src/env.ts:211. This file used to say 4600, so the documented port and the
# actual default disagreed and neither said why.
PORT=4012
NODE_ENV=development
LOG_LEVEL=info
INSTANCE_ID=notify-local
CLOUDSFORGE_TAG=dev

# The base URL this service is reachable at. Used to build links in notifications, and never
# taken from the request Host header — a reset link built from an attacker-supplied Host is how
# a password reset becomes an account takeover.
NOTIFY_PUBLIC_URL=http://localhost:4600

# ---- database ---------------------------------------------------------------
NOTIFY_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/notify
NOTIFY_DATABASE_POOL_MAX=10

# ---- identity ---------------------------------------------------------------
IDENTITY_JWKS_URL=http://localhost:4020/.well-known/jwks.json
IDENTITY_ISSUER=http://localhost:4020

# ---- inbound ----------------------------------------------------------------
# Verifies the HMAC on delivered events, over the raw bytes, before they are parsed.
# Must match the producing side. At least 24 characters.
NOTIFY_INGEST_SIGNING_SECRET=CHANGE_ME_at_least_24_characters

# Presented by the gateway on internal routes.
NOTIFY_GATEWAY_TOKEN=CHANGE_ME_at_least_24_characters

# ---- delivery ---------------------------------------------------------------
NOTIFY_DELIVERY_MAX_ATTEMPTS=6
NOTIFY_DISPATCH_BATCH_SIZE=50

# ---- email ------------------------------------------------------------------
# Generic SMTP, never a provider SDK. Leaving SMTP_HOST unset is a *supported mode*, not an
# error: notifications are recorded as undeliverable rather than lost, and an operator issues
# links by hand. That is how the estate runs today and it must keep working.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CloudsForge <no-reply@cloudsforge.online>
SMTP_REPLY_TO=

# ---- other channels ---------------------------------------------------------
# Each is an adapter behind one interface. Unset means the channel is unavailable, which is a
# recorded delivery outcome rather than a crash. A developer webhook is this same pipeline with
# a different addressing scheme and a signed payload — not a second pipeline.
NOTIFY_WEBPUSH_URL=
NOTIFY_MOBILEPUSH_URL=
NOTIFY_SMS_URL=
